# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
BIMO_BACKEND=nvidia            # nvidia | hermes
NVIDIA_API_KEY=nvapi-cole_sua_chave_aqui
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# HERMES_API_KEY=chave-do-hermes
# LLM_BASE_URL=http://localhost:8642/v1

# Tela
BIMO_ESTILO=bmo                # bmo (padrão) | retro | fofo
BIMO_MODO=rosto                # tela inicial: rosto | relogio | ambos
# BIMO_SUAVE=1                 # bordas suaves do rosto: 1 (leve, padrão no Pi) | 2 (padrão no PC) | 3

# Palavras de voz para trocar a tela (depois de dizer "Bimo")
# BIMO_PALAVRAS_RELOGIO=relogio
# BIMO_PALAVRAS_ROSTO=rosto,carinha,face
# BIMO_PALAVRAS_AMBOS=ambos,os dois,juntos
